# ==========================================
# Personal AI Operator - Environment Config
# ==========================================

# Port Configuration
PORT=4000
ORCHESTRATOR_PORT=8000
DESKTOP_VITE_PORT=5173

# API Server URL
API_BASE_URL=http://localhost:4000/api/v1
INTERNAL_ORCHESTRATOR_URL=http://localhost:8000/internal/v1

# Security & Sessions
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
INTERNAL_SERVICE_KEY=replace_with_internal_service_shared_secret

# Database (PostgreSQL)
# For Cloud PostgreSQL (Neon / Supabase), paste your connection string:
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# LLM Provider Configuration
# Choose primary provider: "gemini" | "openai" | "anthropic"
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Nebius AI / Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1/"
NEBIUS_MODEL="MiniMaxAI/MiniMax-M3"

# Optional: Redis (for background jobs)
REDIS_URL="redis://localhost:6379"

# Google OAuth2 Credentials (Gmail & Calendar)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/connections/gmail/callback
