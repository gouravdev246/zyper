datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users
model User {
  id              String            @id @default(uuid())
  email           String            @unique
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  devices         Device[]
  conversations   Conversation[]
  runs            Run[]
  connections     ToolConnection[]
  permissions     ToolPermission[]
  automationRules AutomationRule[]
  memories        Memory[]
  auditEvents     AuditEvent[]
  scheduledJobs   ScheduledJob[]

  @@map("users")
}

// 2. Devices (Windows Local Companion)
model Device {
  id           String    @id @default(uuid())
  userId       String
  deviceName   String
  pairingCode  String?
  status       String    @default("PENDING") // PENDING, PAIRED, REVOKED
  registeredAt DateTime?
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("devices")
}

// 3. Conversations
model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  runs      Run[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("conversations")
}

// 4. Messages
model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // user, assistant, system
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// 5. Runs
model Run {
  id             String            @id @default(uuid())
  userId         String
  conversationId String?
  goal           String
  status         String            @default("PENDING") // PENDING, RUNNING, WAITING_FOR_APPROVAL, COMPLETED, FAILED, CANCELLED
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?
  tasks          Task[]
  taskDeps       TaskDependency[]
  approvals      ActionApproval[]
  executions     ActionExecution[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("runs")
}

// 6. Tasks
model Task {
  id            String            @id @default(uuid())
  runId         String
  title         String
  description   String?
  toolId        String?
  status        String            @default("PENDING") // PENDING, READY, RUNNING, WAITING_FOR_APPROVAL, COMPLETED, FAILED, SKIPPED
  inputPayload  Json?
  outputPayload Json?
  errorDetails  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  outputs       AgentOutput[]
  approvals     ActionApproval[]
  executions    ActionExecution[]

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("tasks")
}

// 7. Task Dependencies
model TaskDependency {
  id              String @id @default(uuid())
  runId           String
  taskId          String
  dependsOnTaskId String

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([runId])
  @@map("task_dependencies")
}

// 8. Agent Outputs
model AgentOutput {
  id             String   @id @default(uuid())
  taskId         String
  agentName      String
  outputText     String
  structuredData Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("agent_outputs")
}

// 9. Tool Connections (OAuth & Local Adapters)
model ToolConnection {
  id           String            @id @default(uuid())
  userId       String
  provider     String            // gmail, google_calendar, x, windows_companion
  status       String            @default("CONNECTED") // CONNECTED, EXPIRED, REVOKED
  connectedAt  DateTime          @default(now())
  lastSyncAt   DateTime?
  revokedAt    DateTime?
  credentials  OAuthCredential[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("tool_connections")
}

// 10. OAuth Credentials (Encrypted)
model OAuthCredential {
  id                    String    @id @default(uuid())
  connectionId          String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenType             String    @default("Bearer")
  scope                 String
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  connection ToolConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("oauth_credentials")
}

// 11. Tool Permissions
model ToolPermission {
  id               String   @id @default(uuid())
  userId           String
  toolId           String
  allowed          Boolean  @default(true)
  maxDailyCalls    Int?
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@map("tool_permissions")
}

// 12. Automation Rules
model AutomationRule {
  id                String         @id @default(uuid())
  userId            String
  name              String
  triggerType       String         // schedule, event
  cronSchedule      String?
  triggerConditions Json?
  allowedActions    Json?
  isEnabled         Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  jobs              ScheduledJob[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
  @@map("automation_rules")
}

// 13. Action Approvals
model ActionApproval {
  id            String    @id @default(uuid())
  runId         String
  taskId        String
  toolId        String
  actionPayload Json
  description   String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  requestedAt   DateTime  @default(now())
  expiresAt     DateTime
  decidedAt     DateTime?
  decidedBy     String?

  run  Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("action_approvals")
}

// 14. Action Executions (Audit Trail for Side Effects)
model ActionExecution {
  id             String   @id @default(uuid())
  runId          String
  taskId         String
  toolId         String
  idempotencyKey String   @unique
  inputArgs      Json
  resultPayload  Json?
  status         String   // SUCCESS, FAILED, TIMED_OUT
  executedAt     DateTime @default(now())
  durationMs     Int

  run  Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("action_executions")
}

// 15. Memories (Preferences & Facts)
model Memory {
  id        String    @id @default(uuid())
  userId    String
  category  String    // preference, project_fact, instruction
  content   String
  source    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("memories")
}

// 16. Audit Events
model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String   // AUTH, PERMISSION_CHECK, APPROVAL_DECISION, TOOL_EXECUTION, REVOCATION
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_events")
}

// 17. Scheduled Jobs
model ScheduledJob {
  id           String    @id @default(uuid())
  userId       String
  ruleId       String?
  jobType      String
  nextRunAt    DateTime
  lastRunAt    DateTime?
  status       String    @default("SCHEDULED") // SCHEDULED, RUNNING, COMPLETED, FAILED
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([nextRunAt, status])
  @@map("scheduled_jobs")
}
